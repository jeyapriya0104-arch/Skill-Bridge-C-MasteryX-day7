#include <stdio.h>

int main() {
    int a[100], n, i;
    int max, min;
    int *ptr;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    ptr = a;
    max = min = *ptr;

    for (i = 1; i < n; i++) {
        ptr++;

        if (*ptr > max) {
            max = *ptr;
        }

        if (*ptr < min) {
            min = *ptr;
        }
    }

    printf("Maximum element = %d\n", max);
    printf("Minimum element = %d\n", min);

    return 0;
}
